{
  "expo": {
    "name": "habit-tracker",
    "slug": "habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habittracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "18.6",
      "bundleIdentifier": "com.ramimaalouf.habittracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ramimaalouf.habittracker"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.ramimaalouf.habittracker",
          "widgets": [
            {
              "name": "RipplesBoards",
              "displayName": "Ripples",
              "description": "Your boards with seven-day strips and quick check-in.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "systemExtraLarge"
              ]
            }
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e477943-ecf0-4d66-8967-c77e0ec0019c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e477943-ecf0-4d66-8967-c77e0ec0019c"
    }
  }
}
